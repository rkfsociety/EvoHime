{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evohime.local/schema/evohime.protocol.schema.json",
  "title": "EvoHimeProtocol",
  "oneOf": [
    { "$ref": "#/$defs/ServerEvent" },
    { "$ref": "#/$defs/ClientCommand" }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "DateTime": {
      "type": "string",
      "format": "date-time"
    },
    "PlanStep": {
      "type": "object",
      "required": ["id", "tool_name", "description"],
      "properties": {
        "id": { "type": "string" },
        "tool_name": { "type": "string" },
        "description": { "type": "string" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "ServerEvent": {
      "oneOf": [
        { "$ref": "#/$defs/SessionCreatedEvent" },
        { "$ref": "#/$defs/TaskStartedEvent" },
        { "$ref": "#/$defs/AgentMessageDeltaEvent" },
        { "$ref": "#/$defs/AgentPlanUpdatedEvent" },
        { "$ref": "#/$defs/ToolStartedEvent" },
        { "$ref": "#/$defs/ToolOutputEvent" },
        { "$ref": "#/$defs/ToolOutputDeltaEvent" },
        { "$ref": "#/$defs/ToolCompletedEvent" },
        { "$ref": "#/$defs/TaskCompletedEvent" },
        { "$ref": "#/$defs/TaskFailedEvent" },
        { "$ref": "#/$defs/FileChangedEvent" },
        { "$ref": "#/$defs/GitDiffChangedEvent" }
        ,{ "$ref": "#/$defs/TaskStatusChangedEvent" }
        ,{ "$ref": "#/$defs/TaskStepChangedEvent" }
        ,{ "$ref": "#/$defs/ActionLoggedEvent" }
        ,{ "$ref": "#/$defs/ApprovalRequiredEvent" }
        ,{ "$ref": "#/$defs/MemoryProposedEvent" }
        ,{ "$ref": "#/$defs/MemoryAskEvent" }
        ,{ "$ref": "#/$defs/MemoryAcceptedEvent" }
        ,{ "$ref": "#/$defs/MemoryRejectedEvent" }
        ,{ "$ref": "#/$defs/MemoryUsedEvent" }
      ]
    },
    "ClientCommand": {
      "oneOf": [
        { "$ref": "#/$defs/UserMessageCommand" },
        { "$ref": "#/$defs/TaskCancelCommand" },
        { "$ref": "#/$defs/TaskResumeCommand" },
        { "$ref": "#/$defs/TaskRetryCommand" }
        ,{ "$ref": "#/$defs/ApprovalGrantedCommand" }
        ,{ "$ref": "#/$defs/ApprovalDeniedCommand" }
        ,{ "$ref": "#/$defs/MemoryAcceptCommand" }
        ,{ "$ref": "#/$defs/MemoryRejectCommand" }
      ]
    },
    "SessionCreatedEvent": {
      "type": "object",
      "required": ["type", "session_id", "created_at"],
      "properties": {
        "type": { "const": "session.created" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "created_at": { "$ref": "#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "TaskStartedEvent": {
      "type": "object",
      "required": ["type", "task_id", "session_id", "user_message", "created_at"],
      "properties": {
        "type": { "const": "task.started" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "user_message": { "type": "string" },
        "created_at": { "$ref": "#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "AgentMessageDeltaEvent": {
      "type": "object",
      "required": ["type", "task_id", "delta"],
      "properties": {
        "type": { "const": "agent.message.delta" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "delta": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AgentPlanUpdatedEvent": {
      "type": "object",
      "required": ["type", "task_id", "plan"],
      "properties": {
        "type": { "const": "agent.plan.updated" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "plan": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanStep" }
        }
      },
      "additionalProperties": false
    },
    "ToolStartedEvent": {
      "type": "object",
      "required": ["type", "task_id", "tool_name"],
      "properties": {
        "type": { "const": "tool.started" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "tool_name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolOutputEvent": {
      "type": "object",
      "required": ["type", "task_id", "tool_name", "output"],
      "properties": {
        "type": { "const": "tool.output" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "tool_name": { "type": "string" },
        "output": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolOutputDeltaEvent": {
      "type": "object",
      "required": ["type", "task_id", "tool_name", "stream", "delta"],
      "properties": {
        "type": { "const": "tool.output.delta" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "tool_name": { "type": "string" },
        "stream": { "type": "string", "enum": ["stdout", "stderr", "log"] },
        "delta": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolCompletedEvent": {
      "type": "object",
      "required": ["type", "task_id", "tool_name", "success"],
      "properties": {
        "type": { "const": "tool.completed" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "tool_name": { "type": "string" },
        "success": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "TaskCompletedEvent": {
      "type": "object",
      "required": ["type", "task_id", "final_message", "completed_at"],
      "properties": {
        "type": { "const": "task.completed" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "final_message": { "type": "string" },
        "completed_at": { "$ref": "#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "TaskFailedEvent": {
      "type": "object",
      "required": ["type", "task_id", "error"],
      "properties": {
        "type": { "const": "task.failed" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "FileChangedEvent": {
      "type": "object",
      "required": ["type", "path", "change", "created_at"],
      "properties": {
        "type": { "const": "file.changed" },
        "path": { "type": "string" },
        "change": {
          "type": "string",
          "enum": ["created", "updated", "deleted"]
        },
        "created_at": { "$ref": "#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "GitDiffChangedEvent": {
      "type": "object",
      "required": ["type", "status", "diff", "created_at"],
      "properties": {
        "type": { "const": "git.diff.changed" },
        "status": { "type": "string" },
        "diff": { "type": "string" },
        "created_at": { "$ref": "#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "UserMessageCommand": {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "user.message" },
        "content": { "type": "string" },
        "model_route": { "type": "string" },
        "model": { "type": "string" },
        "workspace_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TaskCancelCommand": {
      "type": "object", "required": ["type", "task_id"],
      "properties": { "type": { "const": "task.cancel" }, "task_id": { "$ref": "#/$defs/Uuid" } },
      "additionalProperties": false
    },
    "TaskResumeCommand": {
      "type": "object", "required": ["type", "task_id"],
      "properties": { "type": { "const": "task.resume" }, "task_id": { "$ref": "#/$defs/Uuid" } },
      "additionalProperties": false
    },
    "TaskRetryCommand": {
      "type": "object", "required": ["type", "task_id"],
      "properties": { "type": { "const": "task.retry" }, "task_id": { "$ref": "#/$defs/Uuid" } },
      "additionalProperties": false
    },
    "TaskStatusChangedEvent": {
      "type": "object", "required": ["type", "task_id", "status"],
      "properties": { "type": { "const": "task.status.changed" }, "task_id": { "$ref": "#/$defs/Uuid" }, "status": { "type": "string" } },
      "additionalProperties": false
    },
    "TaskStepChangedEvent": {
      "type": "object", "required": ["type", "task_id", "step_id", "status", "tool_name"],
      "properties": { "type": { "const": "task.step.changed" }, "task_id": { "$ref": "#/$defs/Uuid" }, "step_id": { "$ref": "#/$defs/Uuid" }, "status": { "type": "string" }, "tool_name": { "type": "string" } },
      "additionalProperties": false
    },
    "ActionLoggedEvent": {
      "type": "object", "required": ["type", "task_id", "action", "detail", "created_at"],
      "properties": { "type": { "const": "action.logged" }, "task_id": { "$ref": "#/$defs/Uuid" }, "action": { "type": "string" }, "detail": { "type": "string" }, "created_at": { "$ref": "#/$defs/DateTime" } },
      "additionalProperties": false
    },
    "ApprovalRequiredEvent": {
      "type": "object", "required": ["type", "approval_id", "task_id", "tool_name", "permission", "scope", "created_at"],
      "properties": {
        "type": { "const": "approval.required" }, "approval_id": { "$ref": "#/$defs/Uuid" }, "task_id": { "$ref": "#/$defs/Uuid" }, "tool_name": { "type": "string" }, "permission": { "type": "string" }, "scope": { "type": "string" }, "created_at": { "$ref": "#/$defs/DateTime" }
      }, "additionalProperties": false
    },
    "MemoryProposedEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id", "scope", "kind", "content", "confidence", "status"],
      "properties": {
        "type": { "const": "memory.proposed" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "scope": { "type": "string" },
        "kind": { "type": "string" },
        "content": { "type": "string" },
        "confidence": { "type": "number" },
        "status": { "type": "string" }
      },
      "additionalProperties": false
    },
    "MemoryAskEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id", "scope", "kind", "content", "confidence", "status", "reason"],
      "properties": {
        "type": { "const": "memory.ask" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "scope": { "type": "string" },
        "kind": { "type": "string" },
        "content": { "type": "string" },
        "confidence": { "type": "number" },
        "status": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "MemoryAcceptedEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id"],
      "properties": {
        "type": { "const": "memory.accepted" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" }
      },
      "additionalProperties": false
    },
    "MemoryRejectedEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id"],
      "properties": {
        "type": { "const": "memory.rejected" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" }
      },
      "additionalProperties": false
    },
    "MemoryUsedEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id", "signal", "confidence"],
      "properties": {
        "type": { "const": "memory.used" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "signal": { "type": "string" },
        "confidence": { "type": "number" }
      },
      "additionalProperties": false
    },
    "ApprovalGrantedCommand": {
      "type": "object", "required": ["type", "approval_id"], "properties": { "type": { "const": "approval.granted" }, "approval_id": { "$ref": "#/$defs/Uuid" } }, "additionalProperties": false
    },
    "ApprovalDeniedCommand": {
      "type": "object", "required": ["type", "approval_id"], "properties": { "type": { "const": "approval.denied" }, "approval_id": { "$ref": "#/$defs/Uuid" } }, "additionalProperties": false
    },
    "MemoryAcceptCommand": {
      "type": "object",
      "required": ["type", "memory_id"],
      "properties": {
        "type": { "const": "memory.accept" },
        "memory_id": { "$ref": "#/$defs/Uuid" }
      },
      "additionalProperties": false
    },
    "MemoryRejectCommand": {
      "type": "object",
      "required": ["type", "memory_id"],
      "properties": {
        "type": { "const": "memory.reject" },
        "memory_id": { "$ref": "#/$defs/Uuid" }
      },
      "additionalProperties": false
    }
  }
}
