{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evohime.local/schema/evohime.protocol.schema.json",
  "title": "EvoHimeProtocol",
  "oneOf": [
    { "$ref": "#/$defs/ServerEvent" },
    { "$ref": "#/$defs/ClientCommand" }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "DateTime": {
      "type": "string",
      "format": "date-time"
    },
    "PlanStep": {
      "type": "object",
      "required": ["id", "tool_name", "description"],
      "properties": {
        "id": { "type": "string" },
        "tool_name": { "type": "string" },
        "description": { "type": "string" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "ScoreBreakdown": {
      "type": "object",
      "required": ["similarity_score", "tool_success_rate", "complexity_penalty", "feedback_adjustment", "final_score"],
      "properties": {
        "similarity_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "tool_success_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "complexity_penalty": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "feedback_adjustment": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "final_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    },
    "PlanCandidate": {
      "type": "object",
      "required": ["id", "description", "confidence", "score_breakdown"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "score_breakdown": { "$ref": "#/$defs/ScoreBreakdown" }
      },
      "additionalProperties": false
    },
    "ServerEvent": {
      "oneOf": [
        { "$ref": "#/$defs/SessionCreatedEvent" },
        { "$ref": "#/$defs/TaskStartedEvent" },
        { "$ref": "#/$defs/AgentMessageDeltaEvent" },
        { "$ref": "#/$defs/AgentStatusEvent" },
        { "$ref": "#/$defs/AgentPlanUpdatedEvent" },
        { "$ref": "#/$defs/AgentPlanEvent" },
        { "$ref": "#/$defs/ToolStartedEvent" },
        { "$ref": "#/$defs/ToolOutputEvent" },
        { "$ref": "#/$defs/ToolOutputDeltaEvent" },
        { "$ref": "#/$defs/ToolCompletedEvent" },
        { "$ref": "#/$defs/TaskCompletedEvent" },
        { "$ref": "#/$defs/TaskFailedEvent" },
        { "$ref": "#/$defs/FileChangedEvent" },
        { "$ref": "#/$defs/GitDiffChangedEvent" }
        ,{ "$ref": "#/$defs/TaskStatusChangedEvent" }
        ,{ "$ref": "#/$defs/TaskStepChangedEvent" }
        ,{ "$ref": "#/$defs/ActionLoggedEvent" }
        ,{ "$ref": "#/$defs/ApprovalRequiredEvent" }
        ,{ "$ref": "#/$defs/MemoryProposedEvent" }
        ,{ "$ref": "#/$defs/MemoryAskEvent" }
        ,{ "$ref": "#/$defs/MemoryAcceptedEvent" }
        ,{ "$ref": "#/$defs/MemoryRejectedEvent" }
        ,{ "$ref": "#/$defs/MemoryUsedEvent" }
        ,{ "$ref": "#/$defs/AgentReflectionEvent" }
        ,{ "$ref": "#/$defs/AgentConfidenceEvent" }
      ]
    },
    "ClientCommand": {
      "oneOf": [
        { "$ref": "#/$defs/UserMessageCommand" },
        { "$ref": "#/$defs/TaskCancelCommand" },
        { "$ref": "#/$defs/TaskResumeCommand" },
        { "$ref": "#/$defs/TaskRetryCommand" }
        ,{ "$ref": "#/$defs/TaskPlanApproveCommand" }
        ,{ "$ref": "#/$defs/TaskPlanRejectCommand" }
        ,{ "$ref": "#/$defs/ApprovalGrantedCommand" }
        ,{ "$ref": "#/$defs/ApprovalDeniedCommand" }
        ,{ "$ref": "#/$defs/MemoryAcceptCommand" }
        ,{ "$ref": "#/$defs/MemoryRejectCommand" }
      ]
    },
    "SessionCreatedEvent": {
      "type": "object",
      "required": ["type", "session_id", "created_at"],
      "properties": {
        "type": { "const": "session.created" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "created_at": { "$ref": "#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "TaskStartedEvent": {
      "type": "object",
      "required": ["type", "task_id", "session_id", "user_message", "created_at"],
      "properties": {
        "type": { "const": "task.started" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "user_message": { "type": "string" },
        "created_at": { "$ref": "#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "AgentMessageDeltaEvent": {
      "type": "object",
      "required": ["type", "task_id", "delta"],
      "properties": {
        "type": { "const": "agent.message.delta" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "delta": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AgentStatusEvent": {
      "type": "object",
      "required": ["type", "task_id", "phase"],
      "properties": {
        "type": { "const": "agent.status" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "phase": {
          "type": "string",
          "enum": ["selecting_action", "executing_tools", "waiting_approval", "responding", "stopped"]
        }
      },
      "additionalProperties": false
    },
    "AgentPlanUpdatedEvent": {
      "type": "object",
      "required": ["type", "task_id", "plan"],
      "properties": {
        "type": { "const": "agent.plan.updated" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "plan": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanStep" }
        }
      },
      "additionalProperties": false
    },
    "AgentPlanEvent": {
      "type": "object",
      "required": ["type", "task_id", "candidates", "chosen_plan_id", "reasoning"],
      "properties": {
        "type": { "const": "agent.plan" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanCandidate" }
        },
        "chosen_plan_id": { "type": "string" },
        "reasoning": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolStartedEvent": {
      "type": "object",
      "required": ["type", "task_id", "tool_name"],
      "properties": {
        "type": { "const": "tool.started" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "tool_name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolOutputEvent": {
      "type": "object",
      "required": ["type", "task_id", "tool_name", "output"],
      "properties": {
        "type": { "const": "tool.output" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "tool_name": { "type": "string" },
        "output": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolOutputDeltaEvent": {
      "type": "object",
      "required": ["type", "task_id", "tool_name", "stream", "delta"],
      "properties": {
        "type": { "const": "tool.output.delta" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "tool_name": { "type": "string" },
        "stream": { "type": "string", "enum": ["stdout", "stderr", "log"] },
        "delta": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolCompletedEvent": {
      "type": "object",
      "required": ["type", "task_id", "tool_name", "success"],
      "properties": {
        "type": { "const": "tool.completed" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "tool_name": { "type": "string" },
        "success": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "TaskCompletedEvent": {
      "type": "object",
      "required": ["type", "task_id", "final_message", "completed_at"],
      "properties": {
        "type": { "const": "task.completed" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "final_message": { "type": "string" },
        "completed_at": { "$ref": "#/$defs/DateTime" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "TaskFailedEvent": {
      "type": "object",
      "required": ["type", "task_id", "error"],
      "properties": {
        "type": { "const": "task.failed" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "error": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "FileChangedEvent": {
      "type": "object",
      "required": ["type", "path", "change", "created_at"],
      "properties": {
        "type": { "const": "file.changed" },
        "path": { "type": "string" },
        "change": {
          "type": "string",
          "enum": ["created", "updated", "deleted"]
        },
        "created_at": { "$ref": "#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "GitDiffChangedEvent": {
      "type": "object",
      "required": ["type", "status", "diff", "created_at"],
      "properties": {
        "type": { "const": "git.diff.changed" },
        "status": { "type": "string" },
        "diff": { "type": "string" },
        "created_at": { "$ref": "#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "UserMessageCommand": {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "user.message" },
        "content": { "type": "string" },
        "model_route": { "type": "string" },
        "model": { "type": "string" },
        "workspace_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TaskCancelCommand": {
      "type": "object", "required": ["type", "task_id"],
      "properties": { "type": { "const": "task.cancel" }, "task_id": { "$ref": "#/$defs/Uuid" } },
      "additionalProperties": false
    },
    "TaskResumeCommand": {
      "type": "object", "required": ["type", "task_id"],
      "properties": { "type": { "const": "task.resume" }, "task_id": { "$ref": "#/$defs/Uuid" } },
      "additionalProperties": false
    },
    "TaskRetryCommand": {
      "type": "object", "required": ["type", "task_id"],
      "properties": { "type": { "const": "task.retry" }, "task_id": { "$ref": "#/$defs/Uuid" } },
      "additionalProperties": false
    },
    "TaskPlanApproveCommand": {
      "type": "object", "required": ["type", "task_id", "plan"],
      "properties": {
        "type": { "const": "task.plan.approve" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "plan": { "type": "array", "items": { "$ref": "#/$defs/PlanStep" } }
      },
      "additionalProperties": false
    },
    "TaskPlanRejectCommand": {
      "type": "object", "required": ["type", "task_id"],
      "properties": { "type": { "const": "task.plan.reject" }, "task_id": { "$ref": "#/$defs/Uuid" } },
      "additionalProperties": false
    },
    "TaskStatusChangedEvent": {
      "type": "object", "required": ["type", "task_id", "status"],
      "properties": { "type": { "const": "task.status.changed" }, "task_id": { "$ref": "#/$defs/Uuid" }, "status": { "type": "string" } },
      "additionalProperties": false
    },
    "TaskStepChangedEvent": {
      "type": "object", "required": ["type", "task_id", "step_id", "status", "tool_name"],
      "properties": { "type": { "const": "task.step.changed" }, "task_id": { "$ref": "#/$defs/Uuid" }, "step_id": { "$ref": "#/$defs/Uuid" }, "status": { "type": "string" }, "tool_name": { "type": "string" } },
      "additionalProperties": false
    },
    "ActionLoggedEvent": {
      "type": "object", "required": ["type", "task_id", "action", "detail", "created_at"],
      "properties": { "type": { "const": "action.logged" }, "task_id": { "$ref": "#/$defs/Uuid" }, "action": { "type": "string" }, "detail": { "type": "string" }, "created_at": { "$ref": "#/$defs/DateTime" }, "correlation_id": { "$ref": "#/$defs/Uuid" }, "duration_ms": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "UnifiedDiffReview": {
      "type": "object",
      "required": ["kind", "path", "diff"],
      "properties": {
        "kind": { "const": "unified_diff" },
        "path": { "type": "string" },
        "diff": { "type": "string" }
      },
      "additionalProperties": false
    },
    "FileWriteReview": {
      "type": "object",
      "required": ["kind", "path", "change", "new_bytes"],
      "properties": {
        "kind": { "const": "file_write" },
        "path": { "type": "string" },
        "change": { "type": "string", "enum": ["create", "overwrite"] },
        "old_bytes": { "type": "integer", "minimum": 0 },
        "new_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "UnavailableReview": {
      "type": "object",
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "unavailable" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ApprovalRequiredEvent": {
      "type": "object", "required": ["type", "approval_id", "task_id", "tool_name", "permission", "scope", "risk_level", "created_at"],
      "properties": {
        "type": { "const": "approval.required" }, "approval_id": { "$ref": "#/$defs/Uuid" }, "task_id": { "$ref": "#/$defs/Uuid" }, "tool_name": { "type": "string" }, "permission": { "type": "string" }, "scope": { "type": "string" }, "risk_level": { "type": "string", "enum": ["none", "low", "medium", "high"] }, "review": { "oneOf": [{ "$ref": "#/$defs/UnifiedDiffReview" }, { "$ref": "#/$defs/FileWriteReview" }, { "$ref": "#/$defs/UnavailableReview" }] }, "created_at": { "$ref": "#/$defs/DateTime" }
      }, "additionalProperties": false
    },
    "MemoryProposedEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id", "scope", "kind", "content", "confidence", "status"],
      "properties": {
        "type": { "const": "memory.proposed" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "scope": { "type": "string" },
        "kind": { "type": "string" },
        "content": { "type": "string" },
        "confidence": { "type": "number" },
        "status": { "type": "string" }
      },
      "additionalProperties": false
    },
    "MemoryAskEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id", "scope", "kind", "content", "confidence", "status", "reason"],
      "properties": {
        "type": { "const": "memory.ask" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "scope": { "type": "string" },
        "kind": { "type": "string" },
        "content": { "type": "string" },
        "confidence": { "type": "number" },
        "status": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "MemoryAcceptedEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id"],
      "properties": {
        "type": { "const": "memory.accepted" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" }
      },
      "additionalProperties": false
    },
    "MemoryRejectedEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id"],
      "properties": {
        "type": { "const": "memory.rejected" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" }
      },
      "additionalProperties": false
    },
    "MemoryUsedEvent": {
      "type": "object",
      "required": ["type", "memory_id", "task_id", "signal", "confidence"],
      "properties": {
        "type": { "const": "memory.used" },
        "memory_id": { "$ref": "#/$defs/Uuid" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "signal": { "type": "string" },
        "confidence": { "type": "number" }
      },
      "additionalProperties": false
    },
    "ErrorPattern": {
      "type": "object",
      "required": ["pattern_id", "pattern_name", "confidence", "source"],
      "properties": {
        "pattern_id": { "type": "string" },
        "pattern_name": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "source": { "type": "string", "enum": ["experience_memory", "heuristic"] }
      },
      "additionalProperties": false
    },
    "ReflectionAnalysis": {
      "type": "object",
      "required": ["success_score", "error_patterns", "confidence", "reasoning"],
      "properties": {
        "success_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "error_patterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/ErrorPattern" }
        },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "reasoning": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AgentReflectionEvent": {
      "type": "object",
      "required": ["type", "task_id", "timestamp", "reflection_type", "analysis", "action"],
      "properties": {
        "type": { "const": "agent.reflection" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "timestamp": { "$ref": "#/$defs/DateTime" },
        "reflection_type": {
          "type": "string",
          "enum": ["post_tool_execution", "plan_revision", "error_recovery"]
        },
        "tool_call_id": { "$ref": "#/$defs/Uuid" },
        "analysis": { "$ref": "#/$defs/ReflectionAnalysis" },
        "action": {
          "type": "string",
          "enum": ["proceed", "ask_user", "retry_tool", "revise_plan", "escalate"]
        },
        "recommendation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AgentConfidenceEvent": {
      "type": "object",
      "required": ["type", "task_id", "timestamp", "confidence_score", "risk_level", "decision"],
      "properties": {
        "type": { "const": "agent.confidence" },
        "task_id": { "$ref": "#/$defs/Uuid" },
        "timestamp": { "$ref": "#/$defs/DateTime" },
        "confidence_version": { "type": "string", "default": "1" },
        "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "risk_level": { "type": "string", "enum": ["none", "low", "medium", "high"] },
        "breakdown": {
          "type": "object",
          "properties": {
            "model": { "$ref": "#/$defs/SignalBreakdown" },
            "experience": { "$ref": "#/$defs/SignalBreakdown" },
            "tools": { "$ref": "#/$defs/SignalBreakdown" },
            "reflection": { "$ref": "#/$defs/SignalBreakdown" }
          }
        },
        "reliability": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "experience": { "type": "string" },
            "tools": { "type": "string" },
            "reflection": { "type": "string" }
          }
        },
        "missing_signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendation": { "type": "string", "enum": ["proceed", "ask", "require_approval"] }
      },
      "additionalProperties": false
    },
    "SignalBreakdown": {
      "type": "object",
      "required": ["score", "reliability"],
      "properties": {
        "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "reliability": { "type": "string" },
        "source": { "type": ["string", "null"] },
        "details": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ApprovalGrantedCommand": {
      "type": "object",
      "required": ["type", "approval_id"],
      "properties": {
        "type": { "const": "approval.granted" },
        "approval_id": { "$ref": "#/$defs/Uuid" },
        "remember_path": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "ApprovalDeniedCommand": {
      "type": "object", "required": ["type", "approval_id"], "properties": { "type": { "const": "approval.denied" }, "approval_id": { "$ref": "#/$defs/Uuid" } }, "additionalProperties": false
    },
    "MemoryAcceptCommand": {
      "type": "object",
      "required": ["type", "memory_id"],
      "properties": {
        "type": { "const": "memory.accept" },
        "memory_id": { "$ref": "#/$defs/Uuid" }
      },
      "additionalProperties": false
    },
    "MemoryRejectCommand": {
      "type": "object",
      "required": ["type", "memory_id"],
      "properties": {
        "type": { "const": "memory.reject" },
        "memory_id": { "$ref": "#/$defs/Uuid" }
      },
      "additionalProperties": false
    }
  }
}
