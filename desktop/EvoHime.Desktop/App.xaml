<Application
    x:Class="EvoHime.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
      <Color x:Key="NightBackgroundColor">#090B10</Color>
      <Color x:Key="SurfaceColor">#10141B</Color>
      <Color x:Key="SurfaceRaisedColor">#171C25</Color>
      <Color x:Key="BorderColor">#44202B</Color>
      <Color x:Key="TextColor">#F7F4F5</Color>
      <Color x:Key="MutedTextColor">#8F929D</Color>
      <Color x:Key="PurpleColor">#E3264F</Color>
      <Color x:Key="TealColor">#FF3B5F</Color>
      <SolidColorBrush x:Key="NightBackgroundBrush" Color="{StaticResource NightBackgroundColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
      <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
      <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
      <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="8" />
      </Style>
  </Application.Resources>
</Application>
