<Window
    x:Class="EvoHime.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock x:Name="ConnectionStatus" />
    <TextBlock x:Name="UpdateStatusText" />
    <Button x:Name="UpdateButton" />
    <Button x:Name="ChooseWorkspaceButton" />
    <TextBlock x:Name="WorkspacePathText" />
    <TextBox x:Name="PromptBox" />
    <ScrollViewer>
      <TextBlock x:Name="EventLog" />
    </ScrollViewer>
    <StackPanel x:Name="ApprovalPanel">
      <TextBlock x:Name="ApprovalText" />
      <Button />
      <Button />
    </StackPanel>
    <Button x:Name="StartButton" />
    <Button x:Name="StopButton" />
  </StackPanel>
</Window>
