{
  "name": "evohime-electron",
  "version": "0.1.0",
  "private": true,
  "description": "EvoHime Electron desktop shell (main, preload, renderer)",
  "license": "UNLICENSED",
  "author": "EvoHime",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "bootstrap": "npm ci --ignore-scripts && node scripts/postinstall-allowlist.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:shell": "node scripts/build-electron.mjs shell",
    "build:updater": "node scripts/build-electron.mjs updater",
    "package:from-build": "electron-builder --dir --config electron-builder.yml",
    "package:updater:from-build": "electron-builder --dir --config electron-builder-updater.yml",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/e2e/**",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run",
    "test:parallel": "vitest run --file-parallelism",
    "check:bundle": "node scripts/check-production-bundle.mjs",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "check:protocol": "node scripts/generate-protocol.mjs --check",
    "package": "npm run build && npm run package:from-build"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "dompurify": "3.4.18",
    "fflate": "0.8.3",
    "long": "5.3.2",
    "marked": "18.2.0",
    "protobufjs": "8.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "protobufjs-cli": "2.7.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
