{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvoHime Worker Tasks",
  "description": "JSON Schema registry for all supported Python worker tasks. Load task-specific schema from definitions via (task: string).",
  "definitions": {
    "echo": {
      "type": "object",
      "description": "Echo the input payload back without modification"
    },
    "text.stats": {
      "type": "object",
      "description": "Count characters, words, and lines in text",
      "properties": {
        "text": { "type": "string", "maxLength": 1000000 }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "text.keywords": {
      "type": "object",
      "description": "Extract top keywords from text using word frequency",
      "properties": {
        "text": { "type": "string", "maxLength": 1000000 }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "text.entities": {
      "type": "object",
      "description": "Extract URLs, emails, paths, and ticket IDs from text",
      "properties": {
        "text": { "type": "string", "maxLength": 1000000 }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "text.classify": {
      "type": "object",
      "description": "Classify text intent using lexical rules (bug_report/question/instruction/status_update/general)",
      "properties": {
        "text": { "type": "string", "maxLength": 1000000 }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "text.language": {
      "type": "object",
      "description": "Detect language (Russian/English/mixed) from Cyrillic/Latin ratio",
      "properties": {
        "text": { "type": "string", "maxLength": 1000000 }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "text.redact": {
      "type": "object",
      "description": "Redact secrets, API keys, tokens from text",
      "properties": {
        "text": { "type": "string", "maxLength": 1000000 }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "text.summarize": {
      "type": "object",
      "description": "Summarize text to top N sentences by word frequency",
      "properties": {
        "text": { "type": "string", "maxLength": 1000000 },
        "max_sentences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 3
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "text.chunk": {
      "type": "object",
      "description": "Split text into overlapping chunks for embedding",
      "properties": {
        "text": { "type": "string", "maxLength": 1000000 },
        "chunk_size": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8000,
          "default": 500
        },
        "overlap": {
          "type": "integer",
          "minimum": 0,
          "default": 50
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "text.similarity": {
      "type": "object",
      "description": "Compute bag-of-words cosine similarity between two texts",
      "properties": {
        "text_a": { "type": "string", "maxLength": 1000000 },
        "text_b": { "type": "string", "maxLength": 1000000 }
      },
      "required": ["text_a", "text_b"],
      "additionalProperties": false
    },
    "text.diff": {
      "type": "object",
      "description": "Generate unified diff between two texts",
      "properties": {
        "text_a": { "type": "string", "maxLength": 1000000 },
        "text_b": { "type": "string", "maxLength": 1000000 },
        "context": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 3
        },
        "max_diff_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "default": 500
        }
      },
      "required": ["text_a", "text_b"],
      "additionalProperties": false
    }
  }
}
