{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evohime://contracts/receipts/v1/rotation-state",
  "type": "object",
  "additionalProperties": false,
  "required": ["state_version", "rotation_id", "phase", "old_key_id", "new_key_id", "transition_hash", "created_at", "updated_at", "reason", "actor", "active_key_observed", "audit_event_id"],
  "properties": {
    "state_version": {"const": 1},
    "rotation_id": {"type": "string", "format": "uuid"},
    "phase": {"enum": ["prepared", "transition_durable", "audit_durable", "active_key_replaced", "cleanup_required", "complete"]},
    "old_key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
    "new_key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
    "transition_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "error_code": {"type": ["string", "null"], "maxLength": 64},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "reason": {"enum": ["scheduled", "manual", "compromise", "recovery"]},
    "actor": {"enum": ["system", "user"]},
    "active_key_observed": {"type": "boolean"},
    "audit_event_id": {"type": "string", "maxLength": 128}
  }
}
