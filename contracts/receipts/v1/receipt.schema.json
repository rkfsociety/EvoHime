{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evohime.local/contracts/receipts/v1/receipt.schema.json",
  "title": "EvoHime Receipt Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "key_id", "signature_algorithm", "signature"],
  "properties": {
    "payload": { "$ref": "#/$defs/payload" },
    "key_id": { "$ref": "#/$defs/id" },
    "signature_algorithm": { "const": "Ed25519" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "uuidv7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_version", "receipt_id", "action_id", "receipt_kind", "action_status", "timestamp"],
      "properties": {
        "receipt_version": { "const": 1 },
        "receipt_id": { "$ref": "#/$defs/uuidv7" },
        "action_id": { "$ref": "#/$defs/uuidv7" },
        "receipt_kind": { "enum": ["pre_action", "post_action", "refusal"] },
        "action_status": { "enum": ["prepared", "succeeded", "failed", "cancelled", "refused"] },
        "refusal_code": { "enum": ["policy_denied", "approval_denied", "approval_expired", "approval_stale", "call_changed", "signer_unavailable", "key_untrusted", "recovery_pending"] },
        "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "task_id": { "$ref": "#/$defs/id" }, "run_id": { "$ref": "#/$defs/id" }, "tool_name": { "$ref": "#/$defs/id" },
        "tool_args_hash": { "$ref": "#/$defs/hash" }, "result_hash": { "$ref": "#/$defs/hash" },
        "policy_id": { "$ref": "#/$defs/id" }, "policy_decision": { "enum": ["allow", "deny", "approval_required", "allowed"] },
        "approval_id": { "$ref": "#/$defs/uuidv7" }, "parent_approval_ref": { "$ref": "#/$defs/id" },
        "previous_receipt_hash": { "$ref": "#/$defs/hash" }, "context_ledger_hash": { "$ref": "#/$defs/hash" },
        "model_route": { "type": "object", "additionalProperties": false, "required": ["provider_id", "model_id"], "properties": { "provider_id": { "$ref": "#/$defs/id" }, "model_id": { "$ref": "#/$defs/id" } } }
      },
      "allOf": [{ "oneOf": [
        { "properties": { "receipt_kind": { "const": "pre_action" }, "action_status": { "const": "prepared" }, "result_hash": false, "refusal_code": false } },
        { "required": ["result_hash"], "properties": { "receipt_kind": { "const": "post_action" }, "action_status": { "enum": ["succeeded", "failed", "cancelled"] }, "refusal_code": false } },
        { "required": ["refusal_code"], "properties": { "receipt_kind": { "const": "refusal" }, "action_status": { "const": "refused" }, "result_hash": false } }
      ] }]
    }
  }
}
