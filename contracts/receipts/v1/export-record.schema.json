{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evohime.local/contracts/receipts/v1/export-record.schema.json",
  "title": "EvoHime Receipt Export Record v1",
  "description": "One line of receipts.jsonl. sequence is a decimal string so JSON number precision cannot drift; canonical_envelope decodes to the exact canonical signed envelope bytes for that receipt_hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "record_kind", "sequence", "receipt_hash", "canonical_envelope"],
  "properties": {
    "record_version": { "const": 1 },
    "record_kind": { "const": "receipt" },
    "sequence": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "receipt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonical_envelope": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,10924}$" }
  }
}
