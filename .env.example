DATABASE_URL=postgres://evohime:evohime@localhost:5432/evohime
BIND_ADDR=127.0.0.1:3000
# For LAN access use BIND_ADDR=0.0.0.0:3000 and set EVOHIME_API_TOKEN
# EVOHIME_API_TOKEN=
# EVOHIME_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Allow browser/MCP tools to hit loopback/private IPs (tests / local power users only)
# EVOHIME_SSRF_ALLOW_PRIVATE=1
# Optional MCP host allowlist (comma-separated). When set, mcp.call may only hit these hosts.
# EVOHIME_MCP_ALLOWED_HOSTS=mcp.example.com,localhost
# Shell env: default allowlist only (PATH/HOME/…). Extra names or full inherit (secrets still scrubbed):
# EVOHIME_SHELL_ENV_ALLOW=MY_FLAG,CI
# EVOHIME_SHELL_INHERIT_ENV=1
# Rate limits (0 disables that limit; EVOHIME_RATE_LIMIT_DISABLED=1 turns all off)
# EVOHIME_RATE_LIMIT_SESSION_PER_MIN=30
# EVOHIME_RATE_LIMIT_TASK_PER_MIN=60
# EVOHIME_RATE_LIMIT_WORKER_JOB_PER_MIN=30
# EVOHIME_MAX_CONCURRENT_TASKS=16
# EVOHIME_MAX_CONCURRENT_WORKER_JOBS=32
# Python worker (started by start-dev.ps1; server default matches)
# PYTHON_WORKER_URL=http://127.0.0.1:8090
# LLM retries (initial chat request before SSE; 0 disables)
# EVOHIME_LLM_MAX_RETRIES=3
# EVOHIME_LLM_RETRY_BASE_MS=250
# EVOHIME_LLM_RETRY_MAX_MS=5000
# Auto-resume mutating tasks (write/shell/git/mcp) after server crash — off by default
# EVOHIME_AUTO_RESUME_ON_RESTART=1
# Postgres pool (sqlx)
# EVOHIME_PG_MAX_CONNECTIONS=10
# EVOHIME_PG_MIN_CONNECTIONS=0
# EVOHIME_PG_ACQUIRE_TIMEOUT_SECS=30
# EVOHIME_PG_IDLE_TIMEOUT_SECS=600
# EVOHIME_PG_MAX_LIFETIME_SECS=1800
# Force filesystem.search to use walk fallback instead of ripgrep
# EVOHIME_SEARCH_FORCE_FALLBACK=1
# Metrics: persist snapshots to PG (0 disables); Prometheus text at GET /metrics
# EVOHIME_METRICS_PERSIST_INTERVAL_SECS=60
# EVOHIME_METRICS_HISTORY_LIMIT=2880
# Native OpenAI-compatible tool_calls for planning (0/false disables; default on)
# EVOHIME_NATIVE_TOOL_CALLS=0
WORKSPACE_ROOT=.
DEMO_FILE_PATH=docs/sample-context.md

# LLM — LiteRouter (first provider, stage 2)
MODEL_PROVIDER=literouter
LITEROUTER_API_KEY=
LITEROUTER_BASE_URL=https://api.literouter.com/v1
LITEROUTER_MODEL=deepseek:free

# Memory embeddings — default is local feature-hash; optional remote neural (OpenAI-compatible)
# EVOHIME_EMBEDDING_MODE=remote
# EVOHIME_EMBEDDING_BASE_URL=https://api.literouter.com/v1
# EVOHIME_EMBEDDING_API_KEY=
# EVOHIME_EMBEDDING_MODEL=text-embedding-3-small
# EVOHIME_EMBEDDING_REVISION=0

# OpenTelemetry (optional) — OTLP/HTTP traces for the task pipeline
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=evohime-server
# OTEL_SDK_DISABLED=true

