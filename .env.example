# Скопируй в .env рядом с этим файлом и подставь свой ключ.
# start-dev.ps1 читает только перечисленные ниже имена и передаёт их
# дочерним процессам; сам .env в репозиторий не попадает (.gitignore).

# literouter (по умолчанию) | openai_compatible | mock
MODEL_PROVIDER=literouter

# --- LiteRouter ---
LITEROUTER_API_KEY=
# по умолчанию https://api.literouter.com/v1
LITEROUTER_BASE_URL=
LITEROUTER_MODEL=deepseek:free

# --- OpenAI-совместимый провайдер (нужен при MODEL_PROVIDER=openai_compatible) ---
OPENAI_API_KEY=
# по умолчанию https://api.openai.com/v1
OPENAI_BASE_URL=
# по умолчанию gpt-4o-mini
OPENAI_MODEL=

# Маршрутизация моделей. MODEL_ROUTES_JSON перекрывает всё выше.
MODEL_DEFAULT_ROUTE=default
MODEL_ROUTES_JSON=
